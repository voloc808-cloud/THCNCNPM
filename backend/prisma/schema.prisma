generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DayOffStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPING
  COMPLETED
  CANCELLED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique @db.VarChar(191)
  passwordHash        String               @map("password_hash") @db.VarChar(255)
  googleSub           String?              @unique @map("google_sub") @db.VarChar(255)
  fullName            String               @map("full_name") @db.VarChar(120)
  phone               String?              @unique @db.VarChar(20)
  avatarUrl           String?              @map("avatar_url") @db.VarChar(500)
  role                Role                 @default(CUSTOMER)
  status              UserStatus           @default(ACTIVE)
  emailVerifiedAt     DateTime?            @map("email_verified_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  customerProfile     CustomerProfile?
  staffProfile        StaffProfile?
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  orders              Order[]

  @@index([role, status])
  @@map("users")
}

model CustomerProfile {
  id           String        @id @default(cuid())
  userId       String        @unique @map("user_id")
  dateOfBirth  DateTime?     @map("date_of_birth") @db.Date
  notes        String?       @db.Text
  loyaltyPoint Int           @default(0) @map("loyalty_point")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  reviews      Review[]

  @@map("customer_profiles")
}

model StaffProfile {
  id                String         @id @default(cuid())
  userId            String         @unique @map("user_id")
  bio               String?        @db.Text
  specialties       String?        @db.VarChar(500)
  yearsOfExperience Int            @default(0) @map("years_of_experience")
  averageRating     Decimal        @default(0) @map("average_rating") @db.Decimal(3, 2)
  isBookable        Boolean        @default(true) @map("is_bookable")
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  services          StaffService[]
  shifts            StaffShift[]
  daysOff           StaffDayOff[]
  appointments      Appointment[]
  reviews           Review[]

  @@index([isBookable])
  @@map("staff_profiles")
}

model Service {
  id                  String               @id @default(cuid())
  name                String               @unique @db.VarChar(120)
  slug                String               @unique @db.VarChar(140)
  description         String               @db.Text
  price               Decimal              @db.Decimal(12, 2)
  durationMinutes     Int                  @map("duration_minutes")
  imageUrl            String?              @map("image_url") @db.VarChar(500)
  isActive            Boolean              @default(true) @map("is_active")
  sortOrder           Int                  @default(0) @map("sort_order")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  staff               StaffService[]
  appointmentServices AppointmentService[]

  @@index([isActive, sortOrder])
  @@map("services")
}

model StaffService {
  staffId   String       @map("staff_id")
  serviceId String       @map("service_id")
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([serviceId])
  @@map("staff_services")
}

model StaffShift {
  id        String       @id @default(cuid())
  staffId   String       @map("staff_id")
  dayOfWeek Int          @map("day_of_week") @db.TinyInt
  startTime DateTime     @map("start_time") @db.Time(0)
  endTime   DateTime     @map("end_time") @db.Time(0)
  isActive  Boolean      @default(true) @map("is_active")
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek, startTime, endTime])
  @@index([staffId, dayOfWeek, isActive])
  @@map("staff_shifts")
}

model StaffDayOff {
  id        String       @id @default(cuid())
  staffId   String       @map("staff_id")
  startAt   DateTime     @map("start_at")
  endAt     DateTime     @map("end_at")
  reason    String?      @db.VarChar(500)
  status    DayOffStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, status, startAt, endAt])
  @@map("staff_days_off")
}

model Appointment {
  id                   String               @id @default(cuid())
  code                 String               @unique @db.VarChar(20)
  customerId           String               @map("customer_id")
  staffId              String               @map("staff_id")
  startAt              DateTime             @map("start_at")
  endAt                DateTime             @map("end_at")
  status               AppointmentStatus    @default(PENDING)
  totalDurationMinutes Int                  @map("total_duration_minutes")
  totalPrice           Decimal              @map("total_price") @db.Decimal(12, 2)
  customerNote         String?              @map("customer_note") @db.Text
  cancellationReason   String?              @map("cancellation_reason") @db.VarChar(500)
  reminderSentAt       DateTime?            @map("reminder_sent_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  customer             CustomerProfile      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  staff                StaffProfile         @relation(fields: [staffId], references: [id], onDelete: Restrict)
  services             AppointmentService[]
  review               Review?

  @@index([staffId, startAt, endAt])
  @@index([customerId, createdAt])
  @@index([status, startAt])
  @@map("appointments")
}

model AppointmentService {
  appointmentId   String      @map("appointment_id")
  serviceId       String      @map("service_id")
  serviceName     String      @map("service_name") @db.VarChar(120)
  price           Decimal     @db.Decimal(12, 2)
  durationMinutes Int         @map("duration_minutes")
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service         Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([appointmentId, serviceId])
  @@index([serviceId])
  @@map("appointment_services")
}

model Review {
  id            String          @id @default(cuid())
  appointmentId String          @unique @map("appointment_id")
  customerId    String          @map("customer_id")
  staffId       String          @map("staff_id")
  rating        Int             @db.TinyInt
  comment       String?         @db.Text
  isVisible     Boolean         @default(true) @map("is_visible")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  appointment   Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customer      CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  staff         StaffProfile    @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([staffId, isVisible, createdAt])
  @@index([customerId])
  @@map("reviews")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique @db.VarChar(120)
  slug      String    @unique @db.VarChar(140)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@index([isActive, sortOrder])
  @@map("product_categories")
}

model Product {
  id          String           @id @default(cuid())
  categoryId  String?          @map("category_id")
  name        String           @db.VarChar(160)
  slug        String           @unique @db.VarChar(180)
  sku         String           @unique @db.VarChar(80)
  description String           @db.Text
  price       Decimal          @db.Decimal(12, 2)
  stock       Int              @default(0)
  imageUrl    String?          @map("image_url") @db.VarChar(500)
  isActive    Boolean          @default(true) @map("is_active")
  sortOrder   Int              @default(0) @map("sort_order")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  category    ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems  OrderItem[]

  @@index([categoryId, isActive, sortOrder])
  @@index([stock])
  @@map("products")
}

model Order {
  id              String      @id @default(cuid())
  code            String      @unique @db.VarChar(24)
  userId          String      @map("user_id")
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(12, 2)
  shippingFee     Decimal     @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  recipientName   String      @map("recipient_name") @db.VarChar(120)
  recipientPhone  String      @map("recipient_phone") @db.VarChar(20)
  shippingAddress String      @map("shipping_address") @db.VarChar(500)
  customerNote    String?     @map("customer_note") @db.Text
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items           OrderItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  orderId     String  @map("order_id")
  productId   String  @map("product_id")
  productName String  @map("product_name") @db.VarChar(160)
  sku         String  @db.VarChar(80)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

model LookbookItem {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(120)
  imageUrl  String   @map("image_url") @db.VarChar(500)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder, updatedAt])
  @@map("lookbook_items")
}
