{
  "name": "barber-booking-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c yellow,cyan \"npm run dev -w @barber/api\" \"npm start -w web\"",
    "dev:api": "npm run dev -w @barber/api",
    "dev:web": "npm start -w web",
    "build": "npm run build -w @barber/api && npm run build -w web",
    "db:generate": "npm run db:generate -w @barber/api",
    "db:migrate": "npm run db:migrate -w @barber/api",
    "db:seed": "npm run db:seed -w @barber/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
