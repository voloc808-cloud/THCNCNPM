# Sao chép thành backend/.env trước khi chạy backend/Prisma.
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:4200
DATABASE_URL="mysql://barber:barber_secret@localhost:3306/barber_booking"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
BCRYPT_ROUNDS=12
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Royal Barber <no-reply@royalbarber.local>"
BOOKING_INTERVAL_MINUTES=30
MAX_BOOKING_DAYS_AHEAD=30
MIN_CANCELLATION_HOURS=2
APP_TIMEZONE=Asia/Ho_Chi_Minh
